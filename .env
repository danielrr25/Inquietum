# ── Mode ──────────────────────────────────────────────
# paper | live  (live also requires LIVE_TRADING_CONFIRMED=yes)
MODE=paper
LIVE_TRADING_CONFIRMED=no

# ── Market ────────────────────────────────────────────
CONNECTOR=crypto          # crypto | futures
SYMBOL=BTCUSDT
TIMEFRAME=1h

# ── Binance ───────────────────────────────────────────
BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here
BINANCE_TLD=us            # us for Binance.US, com for Binance.com

# ── Telegram alerts ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Risk (fractions, not percentages: 0.01 = 1%) ──────
MAX_RISK_PER_TRADE_PCT=0.01
STOP_LOSS_PCT=0.05
KILL_SWITCH_DRAWDOWN_PCT=0.15
MAX_OPEN_POSITIONS=1
